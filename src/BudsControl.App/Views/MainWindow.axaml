<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BudsControl.App.Views.MainWindow"
        Title="Buds Control"
        Width="480" Height="640">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="Scan for paired earbuds" Command="{Binding ScanCommand}" />
      <TextBlock Text="Scanning..." IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top"
               Text="{Binding StatusMessage}"
               Foreground="OrangeRed"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="{Binding Address}" Foreground="Gray" FontSize="12" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Battery.LeftPercent, StringFormat='L: {0}%'}" />
                  <TextBlock Text="{Binding Battery.RightPercent, StringFormat='R: {0}%'}" />
                  <TextBlock Text="{Binding Battery.CasePercent, StringFormat='Case: {0}%'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" IsEnabled="{Binding !IsConnecting}" />
                  <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
                </StackPanel>

                <TextBlock Text="Noise control:" IsVisible="{Binding IsConnected}" />
                <ItemsControl ItemsSource="{Binding SupportedModes}" IsVisible="{Binding IsConnected}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}"
                              Command="{Binding $parent[ItemsControl].DataContext.SetModeCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding NoiseControlMode, StringFormat='Current mode: {0}'}" IsVisible="{Binding IsConnected}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
